@echo off
REM Copy this file to config.bat (gitignored) and fill in the values for
REM this machine. start.bat / start_hidden.bat call config.bat if present.
REM For a client, this sets up the plain console client only -- for the
REM tray client (start_tray.bat, no console window), skip this file
REM entirely, it asks for its settings itself on first run.

REM Required on every machine: "server" (the GPU box) or "client".
set KUBUNDICTATE_MODE=client

REM --- Server settings (only used when KUBUNDICTATE_MODE=server) ---
REM set KUBUNDICTATE_HOST=0.0.0.0
REM set KUBUNDICTATE_PORT=50505
REM set KUBUNDICTATE_MODEL=large-v3-turbo
REM set KUBUNDICTATE_LANGUAGE=en

REM --- Client settings (only used when KUBUNDICTATE_MODE=client) ---
REM Point this at the server: LAN IP for same-network use, or a Tailscale
REM IP/hostname (100.x.x.x) for off-LAN use.
set KUBUNDICTATE_SERVER_URL=http://192.168.1.50:50505

REM --- Optional shared secret (set the same value on server + client) ---
REM set KUBUNDICTATE_TOKEN=change-me
