@echo off
REM Copy this file to config.bat (gitignored) and fill in the values for
REM the server. start.bat / start_hidden.bat, next to this file, call
REM config.bat if present. This is server-only -- the tray client
REM (client\windows\start_tray.bat) keeps its own settings under
REM %APPDATA%\KubunDictate\, set up on first run, not through this file.

set KUBUNDICTATE_HOST=0.0.0.0
set KUBUNDICTATE_PORT=9505
set KUBUNDICTATE_MODEL=large-v3-turbo
REM set KUBUNDICTATE_LANGUAGE=en

REM Optional shared secret -- restricts who can use this server. Must use
REM only letters, digits, and -_.~+ (config.bat is parsed by cmd.exe,
REM which mangles other special characters). Enter the same value into
REM each client's tray icon (Enter new server...).
REM set KUBUNDICTATE_TOKEN=change-me
